# shellcheck source=auto/rust
. $ngx_addon_dir/auto/rust

# ngx_addon_name determines the build directory and must be set before any
# modules are defined.
ngx_addon_name=ngx_http_compress

if [ $HTTP = YES ]; then
    # Position the body filter at the gzip slot — after ngx_http_postpone_filter,
    # so subrequests (SSI includes, add_after_body, ...) are fully assembled into
    # the response stream before we compress it. Running earlier would compress
    # main-request buffers before subrequest output is spliced in, corrupting the
    # stream. This is the same ngx_module_order google/ngx_brotli uses.
    #
    # NOTE: NGINX honors this order for DYNAMIC modules (re-sorted at load time),
    # which is the supported build target. For STATICALLY added modules NGINX uses
    # the compile-time array order and does not move the module below postpone, so
    # a static build compresses subrequest-assembled responses at the wrong point.
    # Non-subrequest responses compress correctly in both modes; prefer the
    # dynamic module if you serve SSI/subrequest responses.
    ngx_module_type=HTTP_FILTER
    ngx_module_name=ngx_http_compress_module
    ngx_module_incs=
    ngx_module_deps=
    # Same ordering google/ngx_brotli uses: list our module first, then the full
    # downstream filter chain it must precede in the array (so it installs before
    # them and therefore runs after them — after postpone/ssi splice subrequests).
    ngx_module_order="ngx_http_compress_module \
                      ngx_http_postpone_filter_module \
                      ngx_http_ssi_filter_module \
                      ngx_http_charset_filter_module \
                      ngx_http_xslt_filter_module \
                      ngx_http_image_filter_module \
                      ngx_http_sub_filter_module \
                      ngx_http_addition_filter_module \
                      ngx_http_gunzip_filter_module \
                      ngx_http_userid_filter_module \
                      ngx_http_headers_filter_module \
                      ngx_http_copy_filter_module \
                      ngx_http_range_body_filter_module \
                      ngx_http_not_modified_filter_module \
                      ngx_http_slice_filter_module"

    # ngx-rust target: build the module crate as a staticlib.
    ngx_rust_target_type=LIB
    ngx_rust_target_name=ngx_compress_module

    # Backend is an all-or-nothing switch via NGX_COMPRESS_BACKEND:
    #   (unset|vendored) self-compile the codecs (zlib-ng SIMD, pure-Rust brotli)
    #   system           link the distro's shared libz + libzstd
    #
    # The `-lz`/`-lzstd` link flags matter for the system backend: cargo emits
    # them from the -sys crates, but a staticlib build does not apply them, so
    # NGINX must add them here to get NEEDED entries for the shared objects.
    if [ "${NGX_COMPRESS_BACKEND:-vendored}" = system ]; then
        ngx_rust_target_features="gzip deflate brotli zstd system-libs"
        ngx_module_libs="-lm -ldl -lpthread -lz -lzstd -lbrotlienc -lbrotlicommon"
    else
        ngx_rust_target_features="gzip deflate brotli zstd vendored"
        ngx_module_libs="-lm -ldl -lpthread"
    fi

    ngx_rust_module
fi
